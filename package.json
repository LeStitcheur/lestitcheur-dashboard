{
  "name": "lestitcheur-control",
  "private": true,
  "version": "2.9.2",
  "description": "Dashboard Windows personnel pour serveurs, projets et musique.",
  "author": "LeStitcheur",
  "main": "desktop/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "desktop": "electron .",
    "desktop:build": "powershell.exe -NoProfile -File scripts/build-rdp.ps1 && node scripts/create-icon.mjs && npm run build && electron-builder --win nsis --x64 --publish never && node scripts/update-manifest.mjs",
    "desktop:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop.ps1"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.4",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.0"
  }
}
